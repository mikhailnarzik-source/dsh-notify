{
  "name": "dsh-notify",
  "version": "1.1.4",
  "private": true,
  "description": "Desktop-style task notifications in the Harness look: green/amber/red toasts with their own sounds, live preview, theme and typography settings, and an always-on-top Windows card when the app is not focused.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikhailnarzik-source/dsh-notify.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "native/*.ps1"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
